  "about.title": "À Propos",
  "about.platform": "Une plateforme",
  "about.allInOne": "tout-en-un",
  "about.multiStores": "Multiples Boutiques",
  "about.multiStoresDesc": "Une marketplace qui regroupe vendeurs, artisans et créateurs en un seul endroit.",
  "about.buySell": "Achat & Vente",
  "about.buySellDesc": "Achetez et vendez en toute sécurité avec notre système de facturation intégré.",
